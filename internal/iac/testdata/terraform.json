{
  "format_version": "1.2",
  "terraform_version": "1.9.0",
  "resource_changes": [
    {
      "address": "aws_nat_gateway.this",
      "mode": "managed",
      "type": "aws_nat_gateway",
      "change": { "actions": ["create"], "after": { "subnet_id": "subnet-1" } }
    },
    {
      "address": "aws_eip.nat",
      "mode": "managed",
      "type": "aws_eip",
      "change": { "actions": ["create"], "after": { "domain": "vpc" } }
    },
    {
      "address": "aws_instance.web",
      "mode": "managed",
      "type": "aws_instance",
      "change": { "actions": ["create"], "after": { "instance_type": "t3.micro" } }
    },
    {
      "address": "aws_ebs_volume.data",
      "mode": "managed",
      "type": "aws_ebs_volume",
      "change": { "actions": ["create"], "after": { "type": "gp3", "size": 100 } }
    },
    {
      "address": "aws_vpc_endpoint.if",
      "mode": "managed",
      "type": "aws_vpc_endpoint",
      "change": {
        "actions": ["create"],
        "after": { "vpc_endpoint_type": "Interface", "subnet_ids": ["subnet-a"] }
      }
    },
    {
      "address": "aws_vpc_endpoint.gw",
      "mode": "managed",
      "type": "aws_vpc_endpoint",
      "change": { "actions": ["create"], "after": { "vpc_endpoint_type": "Gateway" } }
    },
    {
      "address": "aws_instance.existing",
      "mode": "managed",
      "type": "aws_instance",
      "change": { "actions": ["no-op"], "after": { "instance_type": "m5.large" } }
    },
    {
      "address": "aws_nat_gateway.old",
      "mode": "managed",
      "type": "aws_nat_gateway",
      "change": { "actions": ["delete"], "after": null }
    },
    {
      "address": "azurerm_public_ip.pip",
      "mode": "managed",
      "type": "azurerm_public_ip",
      "change": { "actions": ["create"], "after": { "sku": [{ "name": "Standard" }] } }
    },
    {
      "address": "azurerm_linux_virtual_machine.vm",
      "mode": "managed",
      "type": "azurerm_linux_virtual_machine",
      "change": { "actions": ["delete", "create"], "after": { "size": "Standard_B1s" } }
    }
  ]
}
